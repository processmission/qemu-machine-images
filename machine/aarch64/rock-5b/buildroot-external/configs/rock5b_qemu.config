BR2_REPRODUCIBLE=y
BR2_SYSTEM_DHCP=""
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_GLOBAL_PATCH_DIR="board/radxa/rock5b/patches $(BR2_EXTERNAL_ROCK5B_QEMU_PATH)/patches"
BR2_ROOTFS_POST_BUILD_SCRIPT=""
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_ROCK5B_QEMU_PATH)/board/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ROCK5B_QEMU_PATH)/board/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS=""
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/radxa/rock5b/linux.fragment $(BR2_EXTERNAL_ROCK5B_QEMU_PATH)/board/linux.config"
# BR2_LINUX_KERNEL_INSTALL_TARGET is not set
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="board/radxa/rock5b/u-boot.fragment $(BR2_EXTERNAL_ROCK5B_QEMU_PATH)/board/uboot.config"
BR2_TARGET_UBOOT_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_ROCK5B_QEMU_PATH)/board/rock5b-qemu.dtsi"
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_USE_BINMAN=y
BR2_TARGET_UBOOT_FORMAT_ITB=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-rockchip-spi.bin"
# BR2_TARGET_ROOTFS_EXT2 is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
