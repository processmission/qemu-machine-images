CONFIG_DEVICE_TREE_INCLUDES="rock5b-qemu.dtsi"
# CONFIG_ENV_IS_IN_MMC is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="sf probe && sf read 0x10000000 0x400000 0xc00000 && bootm 0x10000000"
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTARGS="console=ttyS2,1500000n8 earlycon=uart8250,mmio32,0xfeb50000 rdinit=/init"
