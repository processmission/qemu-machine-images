# BR2_RISCV_ISA_RVV is not set
BR2_TARGET_OPTIMIZATION=""
BR2_REPRODUCIBLE=y
BR2_GLOBAL_PATCH_DIR="/recipe/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="canaan"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP=""
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_ROOTFS_OVERLAY=""
BR2_ROOTFS_POST_BUILD_SCRIPT=""
BR2_ROOTFS_POST_IMAGE_SCRIPT="/recipe/scripts/post-image.sh"
# BR2_LINUX_KERNEL_CUSTOM_GIT is not set
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/ruyisdk/linux-xuantie-kernel/archive/7d4e1f444f461dbe3833bd99a4640e7b6c2cd529.tar.gz"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="/recipe/configs/linux.config"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="canaan/k230-canmv-qemu"
# BR2_PACKAGE_LINUX_TOOLS_GPIO is not set
# BR2_PACKAGE_OBJECT_DETECT_YOLOV8N is not set
