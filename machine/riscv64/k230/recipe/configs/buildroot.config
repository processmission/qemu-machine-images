# BR2_TARGET_ROOTFS_EXT2 is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_TARGET_OPENSBI_LINUX_PAYLOAD is not set
# BR2_TARGET_OPENSBI_INSTALL_PAYLOAD_IMG is not set
BR2_TARGET_OPENSBI_INSTALL_JUMP_IMG=y
BR2_TARGET_OPENSBI_ADDITIONAL_VARIABLES="FW_TEXT_START=0x08000000 FW_JUMP_ADDR=0x08200000 FW_PAYLOAD=n FW_DYNAMIC=n"
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="k230_canmv"
BR2_TARGET_UBOOT_NEEDS_XXD=y
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="/recipe/configs/uboot.config"
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_ELF=y
# BR2_PACKAGE_HOST_GENIMAGE is not set
